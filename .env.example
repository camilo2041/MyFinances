# Copia a ".env" y ajusta. `docker compose` lo lee automáticamente.

# ── Dominio y TLS (Traefik) ───────────────────────────────────────────────
DOMAIN=myfinances.barcam.site
# Nombre del certresolver definido en tu Traefik (ver el ejemplo de bodegapp)
CERT_RESOLVER=mi-resuelves-ssl

# ── Base de datos ─────────────────────────────────────────────────────────
POSTGRES_DB=myfinces
POSTGRES_USER=myfinces
POSTGRES_PASSWORD=pon-aqui-una-clave-fuerte
# Opcional: si la contraseña lleva caracteres raros (@ : / …), define la URL entera
# DATABASE_URL=postgresql+psycopg://myfinces:clave@db:5432/myfinces

# ── Backend ───────────────────────────────────────────────────────────────
# Genera una: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria
TOKEN_TTL_HOURS=168

# Registro público desde la app (true/false)
ALLOW_SIGNUP=true

# Cuenta de administrador que se crea en el primer arranque
ADMIN_EMAIL=admin@myfinances.barcam.site
ADMIN_PASSWORD=pon-aqui-una-clave-fuerte

# Usuario de ejemplo con datos precargados. DÉJALO VACÍO en producción.
DEMO_EMAIL=
DEMO_PASSWORD=

# Orígenes permitidos para CORS. Por defecto = https://$DOMAIN
# CORS_ORIGINS=https://myfinances.barcam.site

# ── Frontend (se hornea en el build) ──────────────────────────────────────
# Por defecto = https://$DOMAIN/api  (Traefik quita el prefijo /api)
# NEXT_PUBLIC_API_URL=https://myfinances.barcam.site/api
